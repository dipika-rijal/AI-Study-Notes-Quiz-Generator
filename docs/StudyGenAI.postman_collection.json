              "mode": "raw",
              "raw": "{\n  \"messages\": [\n    { \"role\": \"user\", \"content\": \"Explain recursion\" },\n    { \"role\": \"assistant\", \"content\": \"Recursion is when a function calls itself...\" }\n  ],\n  \"title\": \"Recursion basics\",\n  \"topic\": \"Computer Science\",\n  \"summary\": \"Discussion about recursion fundamentals\"\n}"
            },
            "url": { "raw": "{{base_url}}/api/conversations/{{conversation_id}}", "host": ["{{base_url}}"], "path": ["api", "conversations", "{{conversation_id}}"] },
            "description": "conversation_id is client-generated (e.g. a UUID) — this creates the conversation if it doesn't exist yet, or updates it if it does."
          }
        },
        {
          "name": "Delete Conversation",
          "request": {
            "method": "DELETE",
