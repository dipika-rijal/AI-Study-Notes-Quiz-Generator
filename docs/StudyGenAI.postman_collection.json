{
  "info": {
    "name": "StudyGen AI",
    "description": "Full API collection for the StudyGen AI backend. Every route below (except /api/health) requires a Firebase ID token in the Authorization header — see the {{token}} variable notes.\n\nHow to get a token quickly for testing:\n1. Log into the app in your browser.\n2. Open DevTools console and run: `await firebase.auth().currentUser.getIdToken()` (or, since this app doesn't expose `firebase` globally, add `window.auth = auth;` temporarily in config/firebase.js, reload, then run `await window.auth.currentUser.getIdToken()`).\n3. Paste the result into this collection's `token` variable.\nTokens expire after 1 hour — re-fetch as needed.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      { "key": "token", "value": "{{token}}", "type": "string" }
    ]
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:5000" },
    { "key": "token", "value": "paste_your_firebase_id_token_here" },
    { "key": "note_id", "value": "" },
    { "key": "quiz_id", "value": "" },
    { "key": "quiz_attempt_id", "value": "" },
    { "key": "conversation_id", "value": "" },
    { "key": "plan_id", "value": "" }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "auth": { "type": "noauth" },
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/health",
              "host": ["{{base_url}}"],
              "path": ["api", "health"]
            }
          }
        }
      ]
    },
    {
      "name": "Notes",
      "item": [
        {
          "name": "Get All Notes",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/api/notes", "host": ["{{base_url}}"], "path": ["api", "notes"] }
          }
        },
        {
          "name": "Get Note By Id",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/api/notes/{{note_id}}", "host": ["{{base_url}}"], "path": ["api", "notes", "{{note_id}}"] }
          }
        },
        {
          "name": "Create Note",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Photosynthesis Basics\",\n  \"body\": \"Photosynthesis converts light energy into chemical energy...\",\n  \"category\": \"Biology\"\n}"
            },
            "url": { "raw": "{{base_url}}/api/notes", "host": ["{{base_url}}"], "path": ["api", "notes"] }
          }
        },
        {
          "name": "Update Note",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Photosynthesis Basics (Updated)\",\n  \"body\": \"Updated note content...\",\n  \"category\": \"Biology\"\n}"
            },
            "url": { "raw": "{{base_url}}/api/notes/{{note_id}}", "host": ["{{base_url}}"], "path": ["api", "notes", "{{note_id}}"] }
          }
        },
        {
          "name": "Delete Note",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": { "raw": "{{base_url}}/api/notes/{{note_id}}", "host": ["{{base_url}}"], "path": ["api", "notes", "{{note_id}}"] }
          }
        }
      ]
    },
    {
      "name": "Quizzes",
      "item": [
        {
          "name": "Generate Quiz (AI)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"topic\": \"Newton's Laws of Motion\",\n  \"sourceType\": \"topic\",\n  \"difficulty\": \"medium\",\n  \"numberOfQuestions\": 5,\n  \"content\": \"\"\n}"
            },
            "url": { "raw": "{{base_url}}/api/quizzes/generate", "host": ["{{base_url}}"], "path": ["api", "quizzes", "generate"] },
            "description": "sourceType: topic | pdf | notes. difficulty: easy | medium | hard | mixed. If sourceType is pdf/notes, put the extracted text in `content`."
          }
        },
        {
          "name": "Retry Quiz (Missed Questions)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"topic\": \"Newton's Laws of Motion\",\n  \"difficulty\": \"medium\",\n  \"numberOfQuestions\": 5,\n  \"missedQuestions\": [\n    {\n      \"question\": \"What is Newton's second law?\",\n      \"selectedAnswer\": \"B\",\n      \"correctAnswer\": \"A\"\n    }\n  ]\n}"
            },
            "url": { "raw": "{{base_url}}/api/quizzes/retry", "host": ["{{base_url}}"], "path": ["api", "quizzes", "retry"] }
          }
        },
        {
          "name": "Check Answer",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"quizId\": \"{{quiz_id}}\",\n  \"questionIndex\": 0,\n  \"selectedAnswer\": \"A\"\n}"
            },
            "url": { "raw": "{{base_url}}/api/quizzes/check-answer", "host": ["{{base_url}}"], "path": ["api", "quizzes", "check-answer"] }
          }
        },
        {
          "name": "Get All Quizzes",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/api/quizzes", "host": ["{{base_url}}"], "path": ["api", "quizzes"] }
          }
        },
        {
          "name": "Get Quiz By Id",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/api/quizzes/{{quiz_id}}", "host": ["{{base_url}}"], "path": ["api", "quizzes", "{{quiz_id}}"] }
          }
        },
        {
          "name": "Create Quiz (Manual)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"topic\": \"Manual Quiz\",\n  \"content\": \"\",\n  \"sourceType\": \"topic\",\n  \"difficulty\": \"medium\",\n  \"totalQuestions\": 1,\n  \"questions\": [\n    {\n      \"question\": \"2 + 2 = ?\",\n      \"options\": [\"3\", \"4\", \"5\", \"6\"],\n      \"correctAnswer\": \"B\"\n    }\n  ]\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{base_url}}/api/quizzes", "host": ["{{base_url}}"], "path": ["api", "quizzes"] },
            "description": "Bypasses AI generation and inserts a quiz document directly — shape should match the Quiz model."
          }
        },
        {
          "name": "Update Quiz",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"score\": 4\n}"
            },
            "url": { "raw": "{{base_url}}/api/quizzes/{{quiz_id}}", "host": ["{{base_url}}"], "path": ["api", "quizzes", "{{quiz_id}}"] }
          }
        },
        {
          "name": "Delete Quiz",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": { "raw": "{{base_url}}/api/quizzes/{{quiz_id}}", "host": ["{{base_url}}"], "path": ["api", "quizzes", "{{quiz_id}}"] }
          }
        }
      ]
    },
